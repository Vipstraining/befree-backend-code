# Database Configuration
MONGODB_URI=mongodb://localhost:27017/food_catalog
DB_NAME=food_catalog

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Production URLs (override defaults)
API_BASE_URL=https://api.befree.fit
FRONTEND_URL=https://beta.befree.fit
ADMIN_URL=https://admin.befree.fit

# SMTP (forgot-password / reset-password emails) — privateemail.com
# (Namecheap Private Email). SMTP_USER is the full mailbox address you set up
# there; SMTP_PASS is that mailbox's password. Code is generic SMTP
# (nodemailer), so any other provider's host/port/user/pass works too.
# Port 465 = implicit SSL (SMTP_SECURE=true); port 587 = STARTTLS
# (SMTP_SECURE=false) — privateemail.com supports both.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your_mailbox_password_here
SMTP_FROM_ADDRESS=noreply@befree.fit
SMTP_FROM_NAME=BeFree
